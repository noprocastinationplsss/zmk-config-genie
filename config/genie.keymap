#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,underglow = &led_strip;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        n {
            bindings = <&kp N>;
            key-positions = <23 22>;
        };

        b {
            bindings = <&kp B>;
            key-positions = <18 19>;
        };
    };



    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp Y  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp GRAVE  &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G  &mo 3  &kp N3  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp ENTER  &kp CAPS  &mo 2  &kp Z  &kp X  &kp C  &kp V  &kp N  &tog 2  &kp B  &kp N  &kp M  &kp DOT  &kp FSLH  &kp RSHFT  &kp LALT  &kp BSPC  &mo 1  &kp LSHFT  &kp SPACE  &kp TAB  &kp LCTRL  &kp LGUI
            >;
        };

        symbolsAndNumbers {
            bindings = <
&kp BSLH  &kp APOS  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp DOLLAR  &trans  &trans  &kp PLUS  &kp LESS_THAN  &kp GREATER_THAN  &kp RIGHT_BRACE  &kp TILDE  &kp FSLH  &kp PIPE  &kp LEFT_PARENTHESIS  &kp DOT  &kp COMMA  &kp QUESTION  &kp UNDERSCORE  &trans  &trans  &kp MINUS  &kp AT_SIGN  &kp HASH  &kp QUESTION  &kp RIGHT_PARENTHESIS  &kp ASTERISK  &kp CARET  &kp N7  &kp N8  &kp N9  &kp N0  &kp N6  &trans  &trans  &kp N5  &kp N1  &kp N2  &kp N3  &kp N4  &kp FSLH  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp C_VOL_UP  &kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_DEC  &trans  &trans  &trans  &kp LEFT  &kp RIGHT  &kp UP  &kp DOWN  &trans  &trans  &trans  &kp LEFT  &kp RIGHT  &kp UP  &kp DOWN  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&bt BT_NXT  &trans  &bt BT_CLR  &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_PRV  &rgb_ug RGB_ON  &rgb_ug RGB_OFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &trans  &trans  &trans  &trans  &rgb_ug RGB_COLOR_HSB(283,30,63)  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &trans  &trans  &trans  &trans  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
