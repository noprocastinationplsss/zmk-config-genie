#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp N1  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp A  &kp S  &kp D  &kp F  &kp N6  &kp Z  &kp X  &kp C  &kp V  &kp GRAVE  &kp LBKT  &kp T  &kp G  &kp B  &kp N5  &kp RBKT  &kp N2  &kp N3  &kp N4  &kp MINUS  &kp SEMI  &kp O  &kp I  &kp U  &kp APOS  &kp P  &kp L  &kp K  &kp J  &kp BSLH  &kp FSLH  &kp DOT  &kp COMMA  &kp M  &kp EQUAL  &kp N0  &kp Y  &kp H  &kp N  &kp PLUS  &kp HASH  &kp EXCL  &kp AT_SIGN  &kp AMPERSAND
            >;
        };
    };
};
